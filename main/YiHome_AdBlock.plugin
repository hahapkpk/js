#!name=YI Home 去广告（小蚁摄像机）
#!desc=适配 YI Home 7.0.6：首页仅保留多分屏，清理广告、促销入口和信息流，不影响摄像头核心功能
#!author=hahapkpk
#!homepage=https://github.com/hahapkpk/js

[Rule]
# === YI Home 7.0.6（2026-11-01）抓包证实的广告网络 ===
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN-SUFFIX,g.doubleclick-cn.net,REJECT
DOMAIN-SUFFIX,adukwai.com,REJECT
DOMAIN-SUFFIX,yfanads.com,REJECT
DOMAIN-SUFFIX,dmrtb.com,REJECT
DOMAIN-SUFFIX,medproad.com,REJECT
DOMAIN-SUFFIX,fancyapi.com,REJECT
DOMAIN-SUFFIX,fancydsp.com,REJECT
DOMAIN-SUFFIX,66mobi.com,REJECT
DOMAIN-SUFFIX,ad.gameley.com,REJECT
DOMAIN-SUFFIX,divms.cn,REJECT
DOMAIN-SUFFIX,adx.adwangmai.com,REJECT
DOMAIN-SUFFIX,funlinkads.com,REJECT
DOMAIN-SUFFIX,adxvip.com,REJECT
DOMAIN-SUFFIX,zhangyuyidong.cn,REJECT
DOMAIN,fg.xiawan8.com,REJECT
DOMAIN,rudder.ydmob.com,REJECT
DOMAIN,in.vipliangmei.com,REJECT
DOMAIN,creative.mergex.cn,REJECT
DOMAIN,adx.ys7.com,REJECT
DOMAIN,track.vol.ad-link.cn,REJECT

# === 三方广告 SDK（开屏/信息流） ===
# 字节/穿山甲(Pangle)
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,pangle.io,REJECT
DOMAIN-SUFFIX,csjdeveloper.com,REJECT

# 快手广告
DOMAIN-SUFFIX,e.kuaishou.cn,REJECT
DOMAIN-SUFFIX,adkwai.com,REJECT

# 腾讯广点通
DOMAIN-SUFFIX,e.qq.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,win.gdt.qq.com,REJECT
DOMAIN-SUFFIX,gdtimg.com,REJECT
DOMAIN-SUFFIX,adsmind.gdtimg.com,REJECT

# 百度广告
DOMAIN-SUFFIX,mobads.baidu.com,REJECT

# （可选）常见统计上报：想更“干净”可以保留；若担心误伤可删
DOMAIN-SUFFIX,umeng.com,REJECT
DOMAIN-SUFFIX,volceapplog.com,REJECT
DOMAIN-SUFFIX,ctobsnssdk.com,REJECT

[Script]
# 官方“配置/广告/运营下发包”：命中后净化 JSON（推荐，不直接 REJECT）
response if ${url} ~= /^https:\/\/gw\.xiaoyi\.com\/(?:v\d+\/app\/config|vas\/v\d+\/equipment\/play\/bannerList02)/ then script("https://raw.githubusercontent.com/hahapkpk/js/main/scripts/xiaoyi_ad_sanitizer.js") with requires_body=true, timeout=10, tag="小蚁配置广告清理"
response if ${url} ~= /^https:\/\/gw\.xiaoyi\.com\/cms\/v\d+\/banner\/getPopupWindow/ then script("https://raw.githubusercontent.com/hahapkpk/js/main/scripts/yi_splash_cleaner.js?v=20261101multi") with requires_body=true, timeout=10, tag="小蚁开屏弹窗清理"
response if ${url} ~= /^https:\/\/gw\.xiaoyi\.com\/cms\/v\d+\/homePagePosition\/valid/ then script("https://raw.githubusercontent.com/hahapkpk/js/main/scripts/yi_splash_cleaner.js?v=20261101multi") with requires_body=true, timeout=10, tag="小蚁首页只保留多分屏"

# （可选兜底）后续若冒出启动/开屏/广告相关接口，可按上面的完整 http-response 格式新增匹配规则。
[MITM]
hostname = gw.xiaoyi.com
