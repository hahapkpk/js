#!name=我的loon去广告（合并版）
#!desc=小蚁：去开屏/弹窗/横幅 + 设备页广告；腾讯文档：清空天枢广告下发（开屏/启动广告）；尽量避免启动变慢
#!author=hahapkpk
#!homepage=https://github.com/hahapkpk/js/main

[Rule]
# ===== 可选：第三方广告 SDK（核心广告域名，通常不影响功能） =====
# 字节/穿山甲(Pangle)
# DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
# DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
# DOMAIN-SUFFIX,pangle.io,REJECT
# DOMAIN-SUFFIX,csjdeveloper.com,REJECT

# 腾讯广点通（腾讯文档里常见）
DOMAIN-SUFFIX,win.gdt.qq.com,REJECT
DOMAIN-SUFFIX,rpt.gdt.qq.com,REJECT
DOMAIN-SUFFIX,t.gdt.qq.com,REJECT
DOMAIN-SUFFIX,nc.gdt.qq.com,REJECT
DOMAIN-SUFFIX,p.l.qq.com,REJECT
DOMAIN-SUFFIX,c.l.qq.com,REJECT
DOMAIN-SUFFIX,pgdt.gtimg.cn,REJECT
DOMAIN-SUFFIX,adkwai.com,REJECT          # 快手广告素材/投放
DOMAIN,nadvideo.baidu.com,REJECT         # 百度广告素材
DOMAIN-SUFFIX,beizi.biz,REJECT           # beizi广告
DOMAIN-SUFFIX,medproad.com,REJECT        # medproad广告/追踪/配置
DOMAIN-SUFFIX,fancyapi.com,REJECT        # fancyapi 广告/追踪


# === 第三方开屏/广告素材与广告SDK（本次日志明确命中） ===
DOMAIN,adtracker.medproad.com,REJECT
DOMAIN,qcwx.medproad.com,REJECT
DOMAIN-SUFFIX,medproad.com,REJECT  # 如果你想一把梭可用这条，但更激进

DOMAIN-SUFFIX,beizi.biz,REJECT

DOMAIN,nadvideo.baidu.com,REJECT
DOMAIN-SUFFIX,adkwai.com,REJECT

DOMAIN-SUFFIX,fancyapi.com,REJECT


[Script]
# 小蚁：全局配置/设备广告净化
response if ${url} ~= /^https:\/\/gw\.xiaoyi\.com\/(?:v\d+\/app\/config|vas\/v\d+\/equipment\/play\/bannerList02)/ then script("https://raw.githubusercontent.com/hahapkpk/js/main/scripts/xiaoyi_ad_sanitizer.js") with requires_body=true, timeout=10, tag="小蚁配置广告清理"
# 小蚁：专杀开屏/弹窗/横幅（getPopupWindow）
response if ${url} ~= /^https:\/\/gw\.xiaoyi\.com\/cms\/v\d+\/banner\/getPopupWindow/ then script("https://raw.githubusercontent.com/hahapkpk/js/main/scripts/yi_splash_cleaner.js") with requires_body=true, timeout=10, tag="小蚁开屏弹窗清理"
# 腾讯文档：清空天枢广告
response if ${url} ~= /^https:\/\/docs\.qq\.com\/api\/advertise\/tianshu\/getads/ then script("https://raw.githubusercontent.com/hahapkpk/js/main/scripts/tdocs_ad_cleaner.js") with requires_body=true, timeout=10, tag="腾讯文档广告清理"

[MITM]
hostname = gw.xiaoyi.com, docs.qq.com
