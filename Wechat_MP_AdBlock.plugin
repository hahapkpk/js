#!name=微信公众号去广告
#!desc=过滤微信公众号正文广告、主页/历史列表广告、商品 CPS、短剧/小程序推广、相关推荐、搜索推荐词、腾讯广告/GDT 视频素材。融合 Map Local 空响应、getappmsgad 响应脚本、reject-dict 兜底与 DOM 容器删除策略。
#!author=ChatGPT
#!homepage=https://github.com/hahapkpk/js
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/WeChat.png

[Rule]
# 微信广告素材域名，日志中出现 wxsmw.wxs.qq.com/ads_svp_video
DOMAIN-SUFFIX,wxs.qq.com,REJECT,extended-matching,pre-matching

[Map Local]
# 公众号正文广告核心接口：用空 JSON 替代 reject，避免微信前端回退或显示异常占位
# getappmsgad 单独交给 wxgzhad.js 处理，不放入 Map Local，避免脚本不执行
^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|jsmonitor|masonryfeed|relatedarticle)\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 公众号相关文章搜索词/推荐词
^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 公众号短剧/小程序推广：日志中出现 mini_drama_info?action=play_info/link
^https:\/\/mp\.weixin\.qq\.com\/mp\/mini_drama_info data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 公众号广告上报与曝光统计
^https:\/\/mp\.weixin\.qq\.com\/tp\/datareport\/report data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/mp\.weixin\.qq\.com\/mp\/masonryfeed_report data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[URL Rewrite]
# 公众号广告接口严格兜底：如果 Map Local 未命中，则 reject-dict
# getappmsgad 单独交给 wxgzhad.js 处理，不在这里 reject
^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|jsmonitor|masonryfeed|relatedarticle)\? reject-dict
^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword reject-dict

# 腾讯广告/GDT 视频广告素材
^https?:\/\/adsmind\.gdtimg\.com\/ads_ reject
^https?:\/\/wxsmw\.wxs\.qq\.com\/.*\/ads_svp_video_ reject
^https?:\/\/[^\/]+\.tfogc\.com(?::\d+)?\/adsmind\.gdtimg\.com\/ads_ reject

# 短剧推广封面图：日志中出现 WxaDramaCoverImage
^https?:\/\/wxaintpcos\.wxqcloud\.qq\.com\.cn\/public\/[^\/]+\/WxaDramaCoverImage\/ reject

[Script]
# getappmsgad 正文广告响应清理：使用成熟脚本处理广告 JSON，避免单纯空响应导致残留框
http-response ^https?:\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad script-path=https://raw.githubusercontent.com/chxm1023/Advertising/main/wxgzhad.js, requires-body=true, timeout=10, tag=微信公众号去广告

# 公众号正文页 + 主页/历史消息页 HTML 兜底：删除已嵌入页面的广告卡片和空白广告框
http-response ^https?:\/\/mp\.weixin\.qq\.com\/(?:s(?:\/|\?)|mp\/profile_ext\?) script-path=https://raw.githubusercontent.com/hahapkpk/js/main/wechat_mp_ad_sanitizer.js, requires-body=true, timeout=10, tag=微信公众号HTML广告容器删除

[MITM]
hostname = %APPEND% mp.weixin.qq.com, adsmind.gdtimg.com, wxsmw.wxs.qq.com, wxaintpcos.wxqcloud.qq.com.cn, *.tfogc.com
