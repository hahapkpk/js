#!name=测网速 去广告
#!desc=基于抓包：移除 iOS 启动页/底部 Banner，并拦截本次日志实际命中的穿山甲、广点通、快手广告链路；不拦友盟/火山统计，尽量减少启动变慢。
#!author=hahapkpk
#!homepage=https://github.com/hahapkpk/js

[Rule]
# ===== 测网速自有广告素材 =====
DOMAIN,ads.uutest.cn,REJECT

# ===== 穿山甲 / Pangle（本次 HAR 大量实际命中） =====
DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT

# ===== 腾讯广点通 / GDT（本次 HAR 实际命中） =====
DOMAIN,sdk.e.qq.com,REJECT
DOMAIN,mi.gdt.qq.com,REJECT

# ===== 快手广告 SDK（本次 HAR 实际命中） =====
DOMAIN,open.e.kuaishou.com,REJECT
DOMAIN,gdfp.gifshow.com,REJECT

# 说明：以下统计/日志域名本次不拦截，避免 App 初始化变慢：
# log-api.pangolin-sdk-toutiao.com
# log-api.pangolin-sdk-toutiao-b.com
# toblog.ctobsnssdk.com
# mssdk.volces.com
# apmplus.volces.com
# tnc3-alisc1.zijieapi.com

[Script]
# 测网速自有广告配置接口（HTTP，无需 MITM）
http-response ^http:\/\/uapi\.uutest\.cn\/ads\/index requires-body=1,script-path=https://raw.githubusercontent.com/hahapkpk/js/main/scripts/uutest_ad_cleaner.js,tag=测网速广告配置清理,timeout=10
