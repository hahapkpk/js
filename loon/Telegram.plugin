#!name=Telegram App 分流
#!desc=完整保留用户提供的49条Telegram及相关客户端规则。安装后将插件PROXY映射到Telegram策略组或所需代理节点；不自动创建策略组，无需MitM。
#!author=hahapkpk
#!homepage=https://github.com/hahapkpk/js
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Telegram.png

[Rule]
DOMAIN,api.imem.app,PROXY
DOMAIN,api.swiftgram.app,PROXY
